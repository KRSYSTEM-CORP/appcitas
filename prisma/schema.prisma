generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// PENDING is only ever the state of the OWNER account created at signup,
// awaiting a super admin's approval (see requireSuperAdmin in lib/session.ts)
// before the business can log in at all. Specialists an owner creates start
// ACTIVE directly — the gate is per-business, not per-login.
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// OWNER manages the business (branding, hours, catalog, staff). SPECIALIST is
// staff with their own agenda — may or may not have login access (see
// Specialist.userId being optional).
enum Role {
  OWNER
  SPECIALIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  PAGO_MOVIL
  BINANCE
  OTHER
}

enum NotificationChannel {
  WHATSAPP
  SMS
  PUSH
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
}

// PACKAGE: one payment covers every session up front (typical for a
// prepaid physio/beauty package). PER_SESSION: the client pays as each
// session is attended, same as a plain one-off appointment.
enum PackagePaymentMode {
  PACKAGE
  PER_SESSION
}

enum PaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BinancePayOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PagoMovilOrderStatus {
  PENDING
  PAID
  EXPIRED
}

// Who decides which specialist handles a given appointment: the client
// picks one during booking (default, matches how booking has always
// worked), or the business assigns it later from the agenda — appointments
// are created without a specialist and staff distribute them among whoever
// is actually available that day. See getAvailableSlotsAnySpecialist in
// lib/actions/public.ts for how availability is computed without a fixed
// specialist.
enum SpecialistAssignmentMode {
  CLIENT_CHOOSES
  BUSINESS_ASSIGNS
}

// A registered business (salon, consultorio, etc.) — the tenant boundary.
// Every other model hangs off businessId either directly or transitively.
model Business {
  id                       String                   @id @default(cuid())
  name                     String
  // Public booking page lives at {subdomain}.<platform-domain>.
  subdomain                String                   @unique
  // Short code staff type in alongside their name+password to log in without
  // an email — mirrors KYRA System's employee login.
  loginCode                String                   @unique
  logoDataUrl              String?
  brandColor               String?
  brandBackground          String?
  timezone                 String                   @default("America/Caracas")
  localCurrencyCode        String                   @default("VES")
  // Whether this business quotes/reports a secondary (foreign) currency
  // alongside localCurrencyCode, using the rate fields below.
  fxEnabled                Boolean                  @default(false)
  foreignCurrencyCode      String                   @default("USD")
  // Local-currency units per 1 foreignCurrencyCode unit — mirrors
  // Company.exchangeRate/exchangeRateUpdatedAt in the ventas-inventario app
  // (single current value + timestamp, not a history log; every Transaction
  // still snapshots its own fxRate, so historical documents are unaffected
  // by later rate changes).
  exchangeRate             Decimal?                 @db.Decimal(18, 6)
  exchangeRateUpdatedAt    DateTime?
  createdAt                DateTime                 @default(now())
  // Maintenance billing, managed by a KR System platform admin from /admin.
  // Priced in USD — the platform's own billing currency, independent of
  // this business' local retail currency above. Mirrors Company in the App
  // Finanzas schema; see lib/billing.ts for the trial/grace/annual-bonus
  // logic shared by both apps.
  isExempt                 Boolean                  @default(false)
  monthlyFeeUsdCents       Int?
  nextPaymentDueDate       DateTime?
  specialistAssignmentMode SpecialistAssignmentMode @default(CLIENT_CHOOSES)

  users            User[]
  specialists      Specialist[]
  services         Service[]
  clients          Client[]
  appointments     Appointment[]
  packages         SessionPackage[]
  businessHours    BusinessHour[]
  payments         Payment[]
  paymentReports   PaymentReport[]
  binancePayOrders BinancePayOrder[]
  pagoMovilOrders  PagoMovilOrder[]
}

// Weekly recurring hours. One row per weekday (0=domingo .. 6=sábado);
// isClosed overrides opensAt/closesAt for days the business doesn't operate.
model BusinessHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  // Optional single daily break (e.g. lunch) carved out of opensAt–closesAt —
  // both null means no break that day. See getAvailableSlots in
  // lib/actions/public.ts for how this is subtracted from the slot grid.
  breakStart String?
  breakEnd   String?

  @@unique([businessId, weekday])
}

// A login — the owner (created at signup) or a specialist with staff access.
model User {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Only owners log in by email; specialists log in with loginCode+name
  // (see loginEmployee-style flow), so this stays optional and unique.
  email        String?    @unique
  firstName    String
  lastName     String
  // Null for an account that only ever signed up/logged in with Google (see
  // app/api/auth/google/callback) — nothing to verify a password against.
  passwordHash String?
  // Google's stable per-account id ("sub" claim) — set the first time this
  // person uses "Continuar con Google", whether that creates a brand-new
  // business or links onto an existing email/password account.
  googleId     String?    @unique
  role         Role       @default(OWNER)
  status       UserStatus @default(ACTIVE)
  // Platform-level administrator (not tied to any one business) — can
  // approve/deny/suspend any business's access from /admin. Not settable
  // from the app itself; only ever changed directly in the database.
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())

  specialist          Specialist?
  passwordResetTokens PasswordResetToken[]

  @@index([businessId])
}

// Single-use, short-lived tokens for the "forgot password" flow. Only the
// sha256 hash of the raw token is stored — like a password itself, the raw
// value only ever exists in the emailed link and the requester's browser, so
// a database leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Specialist {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  displayName    String
  bio            String?
  avatarDataUrl  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // When true, availability for this specialist is further restricted by
  // SpecialistHour on top of the business/service hours (intersected, never
  // widened — a specialist can never be available outside the business's
  // own hours, only more restricted). See getAvailableSlots.
  hasCustomHours Boolean  @default(false)

  services     SpecialistService[]
  appointments Appointment[]
  packages     SessionPackage[]
  hours        SpecialistHour[]

  @@index([businessId])
}

// Weekly recurring hours scoped to one specialist — same shape as
// BusinessHour/ServiceHour, only consulted when Specialist.hasCustomHours is
// true. Intersected with (not a replacement for) the business/service hours
// for that weekday — see getAvailableSlots in lib/actions/public.ts.
model SpecialistHour {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  weekday      Int
  opensAt      String?
  closesAt     String?
  isClosed     Boolean    @default(false)
  breakStart   String?
  breakEnd     String?

  @@unique([specialistId, weekday])
}

model Service {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  durationMinutes   Int
  basePriceCents    Int
  // The currency basePriceCents is actually denominated in — captured at
  // save time so a service's price keeps its real-world meaning even if the
  // business later flips fxEnabled or switches its reference currency.
  // Local-currency display elsewhere converts via the latest ExchangeRate
  // when this differs from Business.localCurrencyCode.
  priceCurrencyCode String   @default("USD")
  category          String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  // When true, availability for this service is driven by ServiceHour
  // instead of the business's default BusinessHour (see getAvailableSlots).
  hasCustomHours    Boolean  @default(false)

  specialists  SpecialistService[]
  appointments Appointment[]
  packages     SessionPackage[]
  hours        ServiceHour[]

  @@index([businessId])
}

// Which specialists can perform which services — a specialist's booking
// options are the intersection of this table, not every service a business
// offers.
model SpecialistService {
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([specialistId, serviceId])
}

// Weekly recurring hours scoped to one service — same shape as BusinessHour,
// only consulted when Service.hasCustomHours is true (see getAvailableSlots
// in lib/actions/public.ts). Replaces BusinessHour entirely for that service
// on the days it applies, rather than intersecting with it.
model ServiceHour {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  weekday    Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean @default(false)
  // Same optional daily break as BusinessHour — see getAvailableSlots.
  breakStart String?
  breakEnd   String?

  @@unique([serviceId, weekday])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  // "Eliminar cliente" is a soft delete (row stays, just hidden from lists
  // and pickers) rather than a real delete — Appointment/Transaction rows
  // keep pointing at a real Client row, so revenue/attendance reports never
  // change just because a client got "deleted".
  active     Boolean  @default(true)

  appointments Appointment[]
  packages     SessionPackage[]

  @@unique([businessId, phone])
}

// A prepaid or tracked set of sessions for the same client+service — e.g. 6
// physiotherapy sessions or a 4-session facial package. Each session is its
// own Appointment (own date/time, own attendance status), linked back here
// via Appointment.packageId; only the payment is optionally handled at this
// level instead of per session (see paymentMode).
// Named SessionPackage (not Package) because "package" is a JS strict-mode
// reserved word — Prisma silently omits any model/field named exactly
// "package" from the generated client. @@map keeps the actual DB table name
// as "Package" (set by the packages_and_cancel_token migration).
model SessionPackage {
  id                       String             @id @default(cuid())
  businessId               String
  business                 Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId                 String
  client                   Client             @relation(fields: [clientId], references: [id])
  specialistId             String
  specialist               Specialist         @relation(fields: [specialistId], references: [id])
  serviceId                String
  service                  Service            @relation(fields: [serviceId], references: [id])
  totalSessions            Int
  paymentMode              PackagePaymentMode @default(PER_SESSION)
  // Only set when paymentMode = PACKAGE — the total price for every session
  // combined (may differ from service.basePriceCents * totalSessions if the
  // business discounts packages).
  packagePriceCents        Int?
  packagePriceCurrencyCode String?
  createdAt                DateTime           @default(now())

  appointments Appointment[]
  transactions Transaction[]

  @@index([businessId])
  @@map("Package")
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  // Null when the business is in BUSINESS_ASSIGNS mode and staff hasn't
  // distributed this appointment to a specialist yet — see
  // SpecialistAssignmentMode and assignSpecialist in lib/actions/appointments.ts.
  specialistId   String?
  specialist     Specialist?       @relation(fields: [specialistId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  // Set when this session belongs to a SessionPackage — sessionNumber is its
  // 1-based position (e.g. 2 of 6) purely for display.
  packageId      String?
  sessionPackage SessionPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  sessionNumber  Int?
  // Lets a client cancel their own appointment from a link (no login) — see
  // app/cancel/[token]. Never regenerated, so an old link always keeps
  // working (or correctly reports "ya fue cancelada" once used).
  cancelToken    String            @unique @default(cuid())
  createdAt      DateTime          @default(now())

  transactions  Transaction[]
  notifications Notification[]

  @@index([businessId, startsAt])
  @@index([specialistId, startsAt])
  @@index([packageId])
}

// One row per payment received — normally against a single Appointment, but
// when a Package is paid as a whole (paymentMode = PACKAGE) the payment is
// recorded against the Package instead (exactly one of appointmentId/
// packageId is set). A target can be paid across several methods (e.g. half
// cash, half Pago Móvil), so this is intentionally a list rather than a
// single record — "fully paid" is derived by summing these, not stored.
model Transaction {
  id                 String          @id @default(cuid())
  appointmentId      String?
  appointment        Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  packageId          String?
  sessionPackage     SessionPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  amountLocalCents   Int
  amountForeignCents Int?
  // Which currency the user actually typed the amount into — the other
  // amount column is derived from this one via fxRate. Lets a single
  // appointment be paid partly in cash USD and partly in VES Pago Móvil and
  // have each line display its own real currency instead of always showing
  // the local-currency equivalent first (see components/agenda/AppointmentCard).
  paidCurrencyCode   String
  currencyLocal      String
  currencyForeign    String?
  fxRate             Decimal?        @db.Decimal(18, 6)
  paymentMethod      PaymentMethod
  // Confirmation/reference number for methods that need one (transferencia,
  // pago móvil, tarjeta, binance) — see PAYMENT_METHODS_REQUIRING_REFERENCE.
  reference          String?
  paidAt             DateTime        @default(now())

  @@index([appointmentId])
  @@index([packageId])
}

model Notification {
  id            String              @id @default(cuid())
  appointmentId String
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  status        NotificationStatus  @default(SCHEDULED)
  scheduledAt   DateTime
  sentAt        DateTime?

  @@index([appointmentId])
}

// Each payment extends Business.nextPaymentDueDate to `periodEnd`. Mirrors
// Payment in the KR POS schema — see lib/billing.ts.
model Payment {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountUsdCents Int
  // Historical: platform Bs/USD rate in effect for this payment, back when
  // subscriptions could be paid in bolívares. Now that payment is exclusively
  // USDT via Binance, this is always null for anything recorded going
  // forward — kept nullable instead of dropped so old records stay intact.
  exchangeRate   Decimal? @db.Decimal(12, 4)
  periodEnd      DateTime
  note           String?
  verifiedById   String
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
}

// A business owner's self-reported claim of having paid the maintenance fee
// externally (per the platform's payment instructions). Stays PENDING until
// a super admin reviews it — approving one creates the matching Payment
// record and pushes out Business.nextPaymentDueDate; rejecting one leaves
// billing state untouched.
model PaymentReport {
  id                String              @id @default(cuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reportedById      String
  // Proof-of-payment image (base64 data URL), same storage pattern as
  // Business.logoDataUrl. Required by the submission form, kept nullable
  // here so a future schema change never needs a backfill.
  proofImageDataUrl String?             @db.Text
  note              String?
  status            PaymentReportStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime            @default(now())
  lines             PaymentReportLine[]

  @@index([businessId, status])
  @@index([status, createdAt])
}

// One payment-method entry in a self-reported maintenance payment (e.g. part
// transferencia, part Pago Móvil).
model PaymentReportLine {
  id              String        @id @default(cuid())
  paymentReportId String
  paymentReport   PaymentReport @relation(fields: [paymentReportId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod
  amountUsdCents  Int
  reference       String?

  @@index([paymentReportId])
}

// A Binance Pay checkout created for a business' maintenance-fee cycle —
// unlike PaymentReport, this needs no manual admin review: the webhook at
// app/api/webhooks/binance-pay/route.ts marks it PAID and advances
// Business.nextPaymentDueDate automatically once Binance confirms funds
// actually arrived (see lib/binance-pay.ts for the signed request/webhook
// verification). merchantTradeNo is the idempotency key both directions —
// Binance echoes it back in the webhook payload, and a retried webhook for
// an already-PAID order is a no-op.
model BinancePayOrder {
  id              String                @id @default(cuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  merchantTradeNo String                @unique
  prepayId        String?
  amountUsdCents  Int
  status          BinancePayOrderStatus @default(PENDING)
  checkoutUrl     String?               @db.Text
  qrcodeLink      String?               @db.Text
  createdAt       DateTime              @default(now())
  paidAt          DateTime?

  @@index([businessId, status])
}

// An expected Pago Móvil (Banesco) payment for a business's maintenance-fee
// cycle — same idea as BinancePayOrder, but there's no merchant API to
// create/confirm a Pago Móvil transfer, so the "order" is really a
// reservation of a specific Bs amount the business is asked to transfer.
// expectedAmountBsCents gets a few random bolívar-cents added on top of the
// real fee (see createPagoMovilOrder in lib/actions/billing.ts) so a
// forwarded bank notification email can be matched back to exactly one
// pending order by amount alone — Pago Móvil references aren't something we
// can pre-assign the way merchantTradeNo works for Binance. See
// app/api/webhooks/banesco-email/route.ts for the other half: parsing the
// forwarded notification email and marking the matching order PAID.
model PagoMovilOrder {
  id                    String               @id @default(cuid())
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountUsdCents        Int
  // Platform Bs/USD rate used to compute expectedAmountBsCents — snapshotted
  // here so the Payment record created on confirmation uses the exact rate
  // that was quoted, even if the platform rate changes before the transfer
  // actually arrives.
  exchangeRate          Decimal              @db.Decimal(12, 4)
  expectedAmountBsCents Int
  status                PagoMovilOrderStatus @default(PENDING)
  // Pending orders older than this stop being eligible to match an incoming
  // email — without an expiry, a stale unpaid reservation could collide
  // with a brand-new one asking for the same bumped amount.
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  paidAt                DateTime?

  @@index([businessId, status])
  @@index([expectedAmountBsCents, status])
}

// Single global row of platform-wide config, managed by the super admin.
// Not scoped by business, so deliberately outside any per-tenant isolation,
// same as User/Business.
model PlatformSettings {
  id                        String   @id
  // Extra free-text notes shown under the Binance details below (e.g. "solo
  // horario laboral", "confirma por WhatsApp antes de enviar") — the QR/ID
  // pair are the actual payment instructions now, this is just supplementary.
  paymentInstructions       String?  @db.Text
  // Binance Pay QR code, shown on /billing so a business can scan it to pay
  // the subscription — same base64 data-URL pattern as Business.logoDataUrl,
  // uploaded via PlatformSettingsForm (resizeImageToDataUrl).
  binanceQrDataUrl          String?  @db.Text
  // Binance Pay ID / UID, shown alongside the QR as a manual fallback for
  // whoever can't scan it.
  binanceId                 String?
  // Applied to Business.monthlyFeeUsdCents automatically when a super admin
  // approves a new signup and leaves the fee field blank (see approveBusiness
  // in lib/actions/admin.ts).
  defaultMonthlyFeeUsdCents Int?
  updatedAt                 DateTime @updatedAt
}
